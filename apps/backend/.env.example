# Neon / PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Clerk (https://dashboard.clerk.com/last-active?path=api-keys)
# NOTE: @clerk/express reads CLERK_PUBLISHABLE_KEY — not the NEXT_PUBLIC_ prefixed
# name, which is a Next.js convention this backend does not use.
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Server
PORT=5001
CORS_ORIGIN="http://localhost:3000"

# Object storage — S3-compatible (AWS S3, Cloudflare R2, MinIO).
# Optional in development: upload endpoints return 503 until these are set.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_PUBLIC_BASE_URL=""
