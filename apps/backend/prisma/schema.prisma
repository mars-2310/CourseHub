// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's TypeScript generator. The legacy "prisma-client-js" provider
  // emits a JS bundle; "prisma-client" emits real TS sources, which is what this
  // Bun + TypeScript backend imports from ./generated/prisma/client.
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum NodeType {
  FOLDER
  VIDEO
  PDF
  TEXT
  QUIZ
  ASSIGNMENT
  LINK
}

model User {
  id             String        @id @default(cuid())
  clerkId        String        @unique // 🔑 Bridges Clerk sessions to your local DB records
  name           String
  email          String        @unique
  role           Role          @default(STUDENT)
  
  organisation   Organisation?
  enrollments    Enrollment[]
  progress       Progress[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Organisation {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?

  ownerId     String   @unique
  owner       User     @relation(fields: [ownerId], references: [id])

  courses     Course[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id             String        @id @default(cuid())
  title          String
  description    String?
  thumbnail      String?
  // Money is Decimal, never Float: binary floating point cannot represent
  // ordinary prices exactly and the error compounds across totals.
  price          Decimal       @db.Decimal(10, 2)
  published      Boolean       @default(false)

  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id])

  nodes          ContentNode[]
  enrollments    Enrollment[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ContentNode {
  id        String       @id @default(cuid())
  title     String
  type      NodeType
  order     Int

  parentId  String?
  parent    ContentNode?  @relation("Tree", fields: [parentId], references: [id])
  children  ContentNode[] @relation("Tree")

  courseId  String
  course    Course        @relation(fields: [courseId], references: [id])

  videoUrl  String?
  pdfUrl    String?
  text      String?
  link      String?
  duration  Int?
  
  progress  Progress[]

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  enrolledAt DateTime @default(now())

  @@unique([studentId, courseId])
}

model Progress {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id])
  nodeId      String
  node        ContentNode @relation(fields: [nodeId], references: [id])
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([studentId, nodeId])
}